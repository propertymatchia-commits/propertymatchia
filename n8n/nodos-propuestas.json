      "name": "Filas propuesta IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        260
      ],
      "parameters": {
        "jsCode": "// Una fila por cada propiedad que eligió la IA. Si no eligió ninguna, no sale nada y el tramo termina.\nconst { ids, clienteId } = $input.first().json;\nreturn ids.map(id => ({ json: { cliente_id: clienteId, propiedad_id: id, origen: 'ia' } }));"
      }
    },
