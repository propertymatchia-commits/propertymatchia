    {
      "id": "f1c83759-d6ba-4865-8ab8-56447d5bc89a",
      "name": "Filas aprobadas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        40
      ],
      "parameters": {
        "jsCode": "// Una fila por cada propiedad aprobada. 'asesor' si la sumó el asesor, 'ia' si ya la había propuesto la IA.\nconst body = $json.body;\nconst aprobadas = String(body.propiedades_aprobadas || '').split(',').filter(Boolean);\nconst agregadas = String(body.propiedades_agregadas || '').split(',').filter(Boolean);\nreturn aprobadas.map(id => ({ json: {\n  cliente_id: body.cliente_id,\n  propiedad_id: Number(id),\n  origen: agregadas.includes(id) ? 'asesor' : 'ia'\n} }));"
      }
    },
