    {
      "id": "dcbdcfe1-9f0b-4aee-8a6e-926fe3603836",
      "name": "¿Aprobada?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2420,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "e46f0103-ab42-4221-85bb-fcd75091c9a8",
              "leftValue": "={{ $json.body.accion }}",
              "rightValue": "aprobar",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e891d93c-b8d7-461f-be23-7f2af93efeb6",
      "name": "Arma mail cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        -200
      ],
      "parameters": {
        "jsCode": "const aprobadas = String($json.body.propiedades_aprobadas || '').split(',');\nconst comentario = $json.body.comentario;\nconst props = $('Toma datos Supabase').all().map(i => i.json)\n  .filter(p => aprobadas.includes(String(p.id)));\n\nconst filas = props.map(p => `\n  <div style=\"border:1px solid #ddd;border-radius:6px;padding:16px;margin-bottom:12px\">\n    <h3 style=\"margin:0 0 4px\">${p.titulo}</h3>\n    <p style=\"margin:0 0 8px;color:#555\">${p.ubicacion} · ${p.dormitorios} dorm. · ${p.moneda || 'USD'} ${Number(p.precio).toLocaleString('es-UY')}</p>\n    <p style=\"margin:0 0 8px\">${p.descripcion || ''}</p>\n    ${p.url ? `<a href=\"${p.url}\">Ver publicación</a>` : ''}\n  </div>`).join('');\n\nconst html = `<p>¡Hola! Gracias por tu consulta. Estas son las propiedades que seleccionamos para vos:</p>\n${filas}\n${comentario ? `<p>${comentario}</p>` : ''}\n<p>Cualquier consulta, respondé este mail y coordinamos una visita.</p>`;\nreturn [{ json: { html } }];"
      }
    },
