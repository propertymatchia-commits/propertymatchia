    {
      "id": "9255c681-d558-426f-9c0e-7e15f6f99d0d",
      "name": "IA elige matches",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Sos asistente de una inmobiliaria. El cliente busca:\n{{ JSON.stringify($('Extrae info a JSON').first().json.output) }}\n\nPropiedades disponibles:\n{{ JSON.stringify($json.propiedades) }}\n\nElegí las propiedades que coincidan con lo que busca el cliente. Tené flexibilidad razonable (por ejemplo, hasta 10% sobre el presupuesto o un dormitorio más), pero nunca cambies el tipo de operación. Solo propiedades con disponible = true.\nRespondé SOLO con JSON, sin texto extra: {\"ids\": [1, 2, 3]}\nSi ninguna coincide: {\"ids\": []}"
      }
    },
    {
      "id": "2942d9f3-2b38-4c48-9523-9e908ca39346",
      "name": "Gemini (matches)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "modelName": "models/gemini-3.1-flash-lite",
        "options": {}
      }
    },
    {
      "id": "91a5170a-dde3-4313-a18c-7486fb9768fe",
      "name": "Arma link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json.text;\nlet ids = [];\ntry {\n  ids = JSON.parse(raw.replace(/```json|```/g, '').trim()).ids || [];\n} catch (e) {\n  ids = [];\n}\nconst clienteId = $('Guardar cliente').first().json.id;\nconst link = `https://propertymatchia.vercel.app/validar.html?cliente=${clienteId}`\n  + `&props=${ids.join(',')}&resume=${encodeURIComponent($execution.resumeUrl)}`;\nreturn [{ json: { ids, clienteId, link } }];"
      }
    },
    {
      "id": "3b5c88d4-5ed0-4ee7-bb83-8c1a9a68476c",
      "name": "¿Hay matches?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "0006154b-94ea-4ef4-8e92-bdc263412bfa",
              "leftValue": "={{ $json.ids.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
